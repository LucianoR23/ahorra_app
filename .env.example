# ── App ───────────────────────────────────────────────────────────────────────
# URL pública canónica de la app (sin trailing slash). La usa Next para
# resolver las imágenes de Open Graph / Twitter en previews al compartir.
# Ej: https://ahorra.app  o  https://ahorra.lemydev.com
NEXT_PUBLIC_APP_URL=

# ── API ───────────────────────────────────────────────────────────────────────
# URL base del backend (sin trailing slash). Sin valor, la app usa
# http://localhost:8080 (nunca un API desplegado).
NEXT_PUBLIC_API_URL=

# ── Marca (plan 0.15b) ────────────────────────────────────────────────────────
# Nombre, bajada y descripción que ve el usuario (títulos, manifest, previews,
# notificaciones). Vacíos = valores actuales. El paso a Valuo es el ítem 1.1.
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_DESCRIPTION=

# ── Versión de la app ─────────────────────────────────────────────────────────
# Se adjunta como `app_version` en la metadata de los reportes de soporte
# (sirve para saber qué build tenía el usuario al reportar un bug). Se inlinea
# en build-time. En prod (Coolify) pasala como build arg = `0.1.0+${SOURCE_COMMIT}`
# para pinpointear el commit. En dev poné `dev` o dejala vacía (manda undefined).
NEXT_PUBLIC_APP_VERSION=dev

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Clave pública VAPID — misma que el backend usa como VAPID_PUBLIC_KEY.
# Generá el par una sola vez con: go run ./cmd/vapidgen (repo del backend).
# La clave PRIVADA queda SOLO en el backend. Nunca la pongas acá.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Google Sign-In ────────────────────────────────────────────────────────────
# OAuth 2.0 Web client ID (Google Cloud Console). Must match the API's
# GOOGLE_OAUTH_CLIENT_ID. Public value, inlined at build time.
# Without it the "Continuar con Google" button is not rendered.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Error monitoring (plan 0.12) ──────────────────────────────────────────────
# DSN del proyecto "app" en GlitchTip (Sentry compatible). Público a propósito:
# solo permite mandar eventos. Vacío = sin monitoreo (el SDK ni se descarga).
# Los eventos salen sin usuario, breadcrumbs, query string ni headers, y con
# emails, IDs, tokens y números borrados (src/lib/monitoring.ts).
# ENVIRONMENT: staging / production en el dashboard. Se inlinean en build-time.
NEXT_PUBLIC_GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=
